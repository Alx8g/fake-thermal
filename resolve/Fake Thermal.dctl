DEFINE_UI_PARAMS(palette, Palette, DCTLUI_COMBO_BOX, 0, { IRONBOW, WHITE_HOT, BLACK_HOT, RAINBOW, ARCTIC, LAVA, GLOWBOW }, { Ironbow, White Hot, Black Hot, Rainbow, Arctic, Lava, Glowbow })
DEFINE_UI_PARAMS(contrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.1, 4.0, 0.01)
DEFINE_UI_PARAMS(level, Level, DCTLUI_SLIDER_FLOAT, 0.0, -0.5, 0.5, 0.01)
DEFINE_UI_PARAMS(amount, Amount, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)

// CLI palette anchors (fake_thermal/infer.py), ordered by the menu above.
__CONSTANT__ float thermal_anchors[5][6][3] = {
    {{0, 0, 0}, {35, 0, 80}, {135, 12, 90}, {230, 60, 20}, {255, 190, 30}, {255, 255, 235}},
    {{0, 0, 90}, {0, 50, 255}, {0, 240, 220}, {100, 255, 0}, {255, 220, 0}, {255, 20, 0}},
    {{0, 0, 25}, {20, 30, 120}, {0, 150, 220}, {110, 235, 255}, {255, 255, 255}, {255, 255, 255}},
    {{0, 0, 0}, {40, 0, 60}, {150, 10, 10}, {230, 90, 10}, {255, 170, 40}, {255, 240, 170}},
    {{10, 0, 60}, {70, 20, 140}, {160, 40, 130}, {220, 90, 60}, {255, 170, 40}, {255, 230, 140}}
};

__DEVICE__ float thermal_mix(float a, float b, float t) {
    return a + (b - a) * t;
}

__DEVICE__ float3 thermal_palette(float heat, int choice) {
    if (choice == WHITE_HOT) return make_float3(heat, heat, heat);
    if (choice == BLACK_HOT) return make_float3(1.0f - heat, 1.0f - heat, 1.0f - heat);

    int row = choice == IRONBOW ? 0 : choice - RAINBOW + 1;
    int segments = choice == ARCTIC ? 4 : 5;
    float x = heat * segments;
    int lo = (int)x;
    if (lo >= segments) lo = segments - 1;
    float t = x - lo;
    float r = thermal_mix(thermal_anchors[row][lo][0], thermal_anchors[row][lo + 1][0], t);
    float g = thermal_mix(thermal_anchors[row][lo][1], thermal_anchors[row][lo + 1][1], t);
    float b = thermal_mix(thermal_anchors[row][lo][2], thermal_anchors[row][lo + 1][2], t);
    return make_float3(r / 255.0f, g / 255.0f, b / 255.0f);
}

__DEVICE__ float3 transform(int width, int height, int x, int y, float r, float g, float b) {
    float luma = 0.2126f * r + 0.7152f * g + 0.0722f * b;
    float heat = _fminf(1.0f, _fmaxf(0.0f, (luma - 0.5f) * contrast + 0.5f + level));
    float3 color = thermal_palette(heat, palette);
    return make_float3(thermal_mix(r, color.x, amount),
                       thermal_mix(g, color.y, amount),
                       thermal_mix(b, color.z, amount));
}
